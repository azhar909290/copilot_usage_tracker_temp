# Existing receiver configuration
HOST=127.0.0.1
PORT=4318
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Read-only access to tthctoinnovation/agentverse-devjourney for the catalogue.
# Keep this token on the Python server, never in NEXT_PUBLIC_* variables.
AGENT_MARKETPLACE_TOKEN=
AGENT_MARKETPLACE_TTL=300

# GitHub Metrics page: both values are configured on the Python server.
GITHUB_METRICS_ORG=your-organization
GITHUB_METRICS_TOKEN=

# Optional: Dynamic JSON mappings to override or add alias -> GitHub username mappings (e.g. {"2722102": "username"})
USER_MAPPINGS=

# Optional: organization name shown above the five demo teams (default tth-cto-innovation).
TEAM_ORGANIZATION=
