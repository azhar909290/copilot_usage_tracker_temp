# Existing receiver configuration
HOST=127.0.0.1
PORT=4318
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Read-only access to tthctoinnovation/agentverse-devjourney for the catalogue.
# Keep this token on the Python server, never in NEXT_PUBLIC_* variables.
AGENT_MARKETPLACE_TOKEN=
AGENT_MARKETPLACE_TTL=300

# GitHub Metrics page: both values are configured on the Python server.
GITHUB_METRICS_ORG=your-organization
GITHUB_METRICS_TOKEN=

# Log Analytics (see TELEMETRY.md). Either provision once with
# `python -m tracker.provision` and copy the three printed values, or let the
# app do it at startup with AUTO_PROVISION=true.
LOG_ANALYTICS_RESOURCE_ID=/subscriptions/<id>/resourceGroups/<rg>/providers/Microsoft.OperationalInsights/workspaces/<name>
AUTO_PROVISION=false
TABLE_RETENTION_DAYS=90
LOG_ANALYTICS_WORKSPACE_ID=
LOGS_INGESTION_ENDPOINT=
DCR_IMMUTABLE_ID=

# Optional: require "Authorization: Bearer <token>" on /v1/traces and /api/v1/diagnostics.
INGEST_TOKEN=

# Tuning (defaults shown)
CACHE_TTL_SECONDS=30
DAILY_TZ=UTC
PRICE_PER_MILLION=0.99
INGEST_BATCH_ROWS=1000
INGEST_FLUSH_SECONDS=2
INGEST_MAX_PENDING_ROWS=200000
