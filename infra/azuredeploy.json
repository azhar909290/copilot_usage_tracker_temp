{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspaceName": {
      "type": "string",
      "metadata": {
        "description": "Existing Log Analytics workspace (must be in the resource group you deploy to)."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Must be the workspace's region."
      }
    },
    "retentionDays": {
      "type": "int",
      "defaultValue": 90,
      "minValue": 30,
      "maxValue": 730
    },
    "appPrincipalId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Object (principal) ID of the App Service's managed identity. Leave empty to assign the roles yourself."
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.OperationalInsights/workspaces/tables",
      "apiVersion": "2022-10-01",
      "name": "[format('{0}/{1}', parameters('workspaceName'), 'CopilotLlmCalls_CL')]",
      "properties": {
        "schema": {
          "name": "CopilotLlmCalls_CL",
          "columns": [
            {
              "name": "TimeGenerated",
              "type": "dateTime"
            },
            {
              "name": "EventTime",
              "type": "dateTime"
            },
            {
              "name": "CallKey",
              "type": "string"
            },
            {
              "name": "TraceId",
              "type": "string"
            },
            {
              "name": "SpanId",
              "type": "string"
            },
            {
              "name": "SessionId",
              "type": "string"
            },
            {
              "name": "Agent",
              "type": "string"
            },
            {
              "name": "Model",
              "type": "string"
            },
            {
              "name": "RequestModel",
              "type": "string"
            },
            {
              "name": "ResponseModel",
              "type": "string"
            },
            {
              "name": "Operation",
              "type": "string"
            },
            {
              "name": "Service",
              "type": "string"
            },
            {
              "name": "InputTokens",
              "type": "long"
            },
            {
              "name": "OutputTokens",
              "type": "long"
            },
            {
              "name": "LatencyMs",
              "type": "real"
            }
          ]
        },
        "retentionInDays": "[parameters('retentionDays')]",
        "totalRetentionInDays": "[parameters('retentionDays')]"
      }
    },
    {
      "type": "Microsoft.OperationalInsights/workspaces/tables",
      "apiVersion": "2022-10-01",
      "name": "[format('{0}/{1}', parameters('workspaceName'), 'CopilotIdentity_CL')]",
      "properties": {
        "schema": {
          "name": "CopilotIdentity_CL",
          "columns": [
            {
              "name": "TimeGenerated",
              "type": "dateTime"
            },
            {
              "name": "EventTime",
              "type": "dateTime"
            },
            {
              "name": "TraceId",
              "type": "string"
            },
            {
              "name": "SessionId",
              "type": "string"
            },
            {
              "name": "UserLogin",
              "type": "string"
            },
            {
              "name": "UserKey",
              "type": "string"
            },
            {
              "name": "Tier",
              "type": "int"
            },
            {
              "name": "Source",
              "type": "string"
            }
          ]
        },
        "retentionInDays": "[parameters('retentionDays')]",
        "totalRetentionInDays": "[parameters('retentionDays')]"
      }
    },
    {
      "type": "Microsoft.Insights/dataCollectionRules",
      "apiVersion": "2023-03-11",
      "name": "copilot-usage-dcr",
      "location": "[parameters('location')]",
      "kind": "Direct",
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces/tables', parameters('workspaceName'), 'CopilotLlmCalls_CL')]",
        "[resourceId('Microsoft.OperationalInsights/workspaces/tables', parameters('workspaceName'), 'CopilotIdentity_CL')]"
      ],
      "properties": {
        "streamDeclarations": {
          "Custom-CopilotLlmCalls_CL": {
            "columns": [
              {
                "name": "EventTime",
                "type": "datetime"
              },
              {
                "name": "CallKey",
                "type": "string"
              },
              {
                "name": "TraceId",
                "type": "string"
              },
              {
                "name": "SpanId",
                "type": "string"
              },
              {
                "name": "SessionId",
                "type": "string"
              },
              {
                "name": "Agent",
                "type": "string"
              },
              {
                "name": "Model",
                "type": "string"
              },
              {
                "name": "RequestModel",
                "type": "string"
              },
              {
                "name": "ResponseModel",
                "type": "string"
              },
              {
                "name": "Operation",
                "type": "string"
              },
              {
                "name": "Service",
                "type": "string"
              },
              {
                "name": "InputTokens",
                "type": "long"
              },
              {
                "name": "OutputTokens",
                "type": "long"
              },
              {
                "name": "LatencyMs",
                "type": "real"
              }
            ]
          },
          "Custom-CopilotIdentity_CL": {
            "columns": [
              {
                "name": "EventTime",
                "type": "datetime"
              },
              {
                "name": "TraceId",
                "type": "string"
              },
              {
                "name": "SessionId",
                "type": "string"
              },
              {
                "name": "UserLogin",
                "type": "string"
              },
              {
                "name": "UserKey",
                "type": "string"
              },
              {
                "name": "Tier",
                "type": "int"
              },
              {
                "name": "Source",
                "type": "string"
              }
            ]
          }
        },
        "destinations": {
          "logAnalytics": [
            {
              "workspaceResourceId": "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspaceName'))]",
              "name": "workspace"
            }
          ]
        },
        "dataFlows": [
          {
            "streams": [
              "Custom-CopilotLlmCalls_CL"
            ],
            "destinations": [
              "workspace"
            ],
            "transformKql": "source | extend TimeGenerated = now()",
            "outputStream": "Custom-CopilotLlmCalls_CL"
          },
          {
            "streams": [
              "Custom-CopilotIdentity_CL"
            ],
            "destinations": [
              "workspace"
            ],
            "transformKql": "source | extend TimeGenerated = now()",
            "outputStream": "Custom-CopilotIdentity_CL"
          }
        ]
      }
    },
    {
      "condition": "[not(empty(parameters('appPrincipalId')))]",
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[concat('Microsoft.Insights/dataCollectionRules/', 'copilot-usage-dcr')]",
      "name": "[guid(parameters('appPrincipalId'), 'publisher', resourceGroup().id)]",
      "dependsOn": [
        "[resourceId('Microsoft.Insights/dataCollectionRules', 'copilot-usage-dcr')]"
      ],
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '3913510d-42f4-4e42-8a64-420c93043f8e')]",
        "principalId": "[parameters('appPrincipalId')]",
        "principalType": "ServicePrincipal"
      }
    }
  ],
  "outputs": {
    "LOG_ANALYTICS_WORKSPACE_ID": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspaceName')), '2022-10-01').customerId]"
    },
    "LOGS_INGESTION_ENDPOINT": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Insights/dataCollectionRules', 'copilot-usage-dcr'), '2023-03-11').endpoints.logsIngestion]"
    },
    "DCR_IMMUTABLE_ID": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Insights/dataCollectionRules', 'copilot-usage-dcr'), '2023-03-11').immutableId]"
    }
  }
}
